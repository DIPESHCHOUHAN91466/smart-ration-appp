{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/SmartRation.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5188
    },
    {
      "name": "ai",
      "runtimeExecutable": "ai/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "ai.api.main:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8001",
        "--app-dir",
        "."
      ],
      "port": 8001
    },
    {
      "name": "python-api",
      "runtimeExecutable": "backend/SmartRation/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--app-dir",
        "backend/SmartRation"
      ],
      "port": 8000
    }
  ]
}