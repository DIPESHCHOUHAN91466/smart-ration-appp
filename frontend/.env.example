# Empty (recommended): same-origin /api/v1; Vite proxies /api to 127.0.0.1:8000 in development. The HttpOnly
# session cookie only works same-origin, so another value ends sessions after 15 minutes.
VITE_API_BASE_URL=
VITE_APP_NAME=Smart Ration HSD2C
# Optional, PUBLIC (printed on the login page): the synthetic demo accounts' password, for the demo buttons.
VITE_DEMO_PASSWORD=
