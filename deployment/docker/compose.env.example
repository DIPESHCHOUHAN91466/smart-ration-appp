# Copy to the repository root as .env (git-ignored) and fill in. Never commit real values.
# Used by docker-compose.yml.

# MySQL container (a separate database from any MySQL on the host)
MYSQL_ROOT_PASSWORD=
MYSQL_USER=smartration_app
MYSQL_PASSWORD=
MYSQL_HOST_PORT=3307

# Must equal the C# API's Jwt:Key so tokens work on both backends.
JWT_SECRET_KEY=

# The C# API on the host, for routes not yet migrated. Empty disables the fallback proxy.
LEGACY_API_URL=http://host.docker.internal:5188
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO

# Synthetic seed data (empty tables only). Users are created only if a password is set.
RUN_DB_SEED=false
SEED_DEMO_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
