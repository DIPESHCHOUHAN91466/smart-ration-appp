# Copy to deployment/docker/.env (git-ignored) and fill in. Never commit real values.
# Used by deployment/docker/docker-compose.yml (docker compose -f deployment/docker/docker-compose.yml up --build).

# MySQL container (a separate database from any MySQL on the host)
MYSQL_ROOT_PASSWORD=
MYSQL_USER=smartration_app
MYSQL_PASSWORD=
MYSQL_HOST_PORT=3307

# Shared by both backends so a token issued by one is accepted by the other (64+ random characters).
JWT_SECRET_KEY=
# Signs booking QR codes (HMAC-SHA256); changing it invalidates every issued QR code. Generate once:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
QR_SECRET=

ENVIRONMENT=production
LOG_LEVEL=INFO
# Build-time: the login page lists the synthetic demo accounts.
VITE_DEMO_MODE=true

# Synthetic seed data (empty tables only). Demo users are created only if a password is set.
RUN_DB_SEED=true
SEED_DEMO_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
