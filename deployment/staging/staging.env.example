# STAGING — a public demonstration on SYNTHETIC data (what render.yaml deploys).
# Template only: names and safe values. Secrets stay EMPTY here and are set in the hosting dashboard
# (Render: "sync: false" / generated values) or a secret manager — never in git.
# Checked by backend/SmartRation/tests/unit/test_env_templates.py: every key must be a real setting.
# One service: the Python backend (backend/SmartRation), which also serves the website. The C# API is retired.

ENVIRONMENT=production
DATA_MODE=synthetic
# mysql+pymysql://USER:PASSWORD@HOST:PORT/smartration?charset=utf8mb4&ssl_ca=/tmp/mysql-ca.pem
DATABASE_URL=
# PEM text of the database provider's CA certificate; the entrypoint writes it to /tmp/mysql-ca.pem
MYSQL_SSL_CA=
# 64+ random characters
JWT_SECRET_KEY=
# signs QR tokens; never change it after the first deploy (it invalidates every issued QR code)
QR_SECRET=
DEMO_OTP_ENABLED=false
# synthetic demo only: sign-in codes are logged, not sent (refused with real data)
SMS_ALLOW_MOCK_OUTSIDE_DEVELOPMENT=true
# empty: the retired C# API is not used
LEGACY_API_URL=
# only needed if the browser calls the API from another origin (the Docker image serves both on one)
CORS_ORIGINS=
LOG_LEVEL=INFO
# the Docker image sets FRONTEND_DIST_DIR itself
RUN_DB_SETUP=true
# synthetic reference data into EMPTY tables only
RUN_DB_SEED=true
# the AI analytics service is not deployed on staging
AI_SERVICE_URL=
CHATBOT_PROVIDER=knowledge
# demo accounts get this password (empty = no demo users are created)
SEED_DEMO_PASSWORD=
# build-time: the login page lists the synthetic demo accounts
VITE_DEMO_MODE=true
