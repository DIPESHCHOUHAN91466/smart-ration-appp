# PRODUCTION — real citizens. BLOCKED — REQUIRES EXTERNAL INTEGRATION: with DATA_MODE=real both backends
# refuse to start until real providers exist (database/seeds/REAL_DATA.md). This template records what the
# configuration must look like when that work is done; do not deploy it before every item in CHECKLIST.md.
# Secrets stay EMPTY here and come from a secret manager — never from git or a shared document.
# Checked by backend/SmartRation/tests/unit/test_env_templates.py: every key must be a real setting.

# ---- shared by both backends ---------------------------------------------------------------
ENVIRONMENT=production
DATA_MODE=real
# a SEPARATE database from staging and every test database; TLS required
DATABASE_URL=
MYSQL_SSL_CA=
# new random key (64+ chars), never reused from staging or development
JWT_SECRET_KEY=

# ---- Python gateway ---------------------------------------------------------------------------
LEGACY_API_URL=
# the exact public origin(s) of the website, comma-separated; never "*"
CORS_ORIGINS=
LOG_LEVEL=INFO
# production schema changes are applied deliberately (setup_database.py / alembic upgrade) after a backup
RUN_DB_SETUP=false
# never seed synthetic data into a real-data database
RUN_DB_SEED=false
WAIT_FOR_LEGACY_API=true
AI_SERVICE_URL=
CHATBOT_PROVIDER=knowledge
VITE_DEMO_MODE=false
# HMAC key that signs every booking QR (64+ random chars). Set ONCE before the first booking and never change
# it: a new value invalidates every QR already issued. Never reuse the staging/development value.
QR_SECRET=
# OTP fallback: real SMS only (a DLT-registered gateway); the app refuses to start with the demo OTP or mock SMS
DEMO_OTP_ENABLED=false
SMS_PROVIDER=http
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_ALLOW_MOCK_OUTSIDE_DEVELOPMENT=false
# AI analytics service (forecasts, alerts, OCR); empty URL = not deployed
AI_SERVICE_API_KEY=
# the backend serves the built website itself (the Docker image sets this; leave empty otherwise)
FRONTEND_DIST_DIR=

# ---- C# business API (RETIRED: the Python gateway now serves every route; kept for reference only) ----- ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
Qr__Secret=
Demo__DemoMode=false
Demo__DemoOtpEnabled=false
Demo__UseSyntheticAadhaar=false
Demo__UseSyntheticPassbook=false
Demo__UseSyntheticMapData=false
# a DLT-registered SMS gateway; Mock is refused outside Development
Sms__Provider=Http
Sms__BaseUrl=
Sms__ApiKey=
Sms__SenderId=
Sms__AllowMockOutsideDevelopment=false
AiService__BaseUrl=
AiService__ApiKey=
