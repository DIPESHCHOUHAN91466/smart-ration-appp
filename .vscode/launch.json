{
  // Run and Debug (Ctrl+Shift+D). "Smart Ration: Full Stack" launches all four services with debuggers attached.
  // Requires the extensions in extensions.json (C#, Python/debugpy, JavaScript debugger is built in).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Smart Ration: .NET API (:5188)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Backend: Build",
      "program": "${workspaceFolder}/backend/SmartRation.Api/bin/Debug/net8.0/SmartRation.Api.dll",
      "cwd": "${workspaceFolder}/backend/SmartRation.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5188"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Smart Ration: Python API (:8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:create_app", "--factory", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend/SmartRation",
      "python": "${workspaceFolder}/backend/SmartRation/.venv/Scripts/python.exe",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Smart Ration: AI Service (:8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["ai.api.main:create_app", "--factory", "--host", "127.0.0.1", "--port", "8001"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/ai/.venv/Scripts/python.exe",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Smart Ration: Frontend (:5173)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "Smart Ration: Browser (Edge, frontend debugging)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    },
    {
      "name": "Smart Ration: Python Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}/backend/SmartRation",
      "python": "${workspaceFolder}/backend/SmartRation/.venv/Scripts/python.exe",
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Smart Ration: .NET Tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "dotnet test SmartRation.sln -c Release",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Smart Ration: Frontend Tests (Vitest)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm test",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Smart Ration: Full Stack",
      "configurations": [
        "Smart Ration: .NET API (:5188)",
        "Smart Ration: AI Service (:8001)",
        "Smart Ration: Python API (:8000)",
        "Smart Ration: Frontend (:5173)"
      ],
      "stopAll": true
    }
  ]
}
