# ALLOW-LIST. Docker builds use the repository root as context (backend/SmartRation/Dockerfile and
# backend/SmartRation.Api/Dockerfile),
# so everything is excluded unless listed below — secrets, backups, node_modules and venvs can't leak in.
*
!backend/SmartRation/requirements.txt
!backend/SmartRation/alembic.ini
!backend/SmartRation/docker-entrypoint.sh
!backend/SmartRation/app/**
!backend/SmartRation/scripts/**
!ai/chatbot/knowledge/**
!data/synthetic/reference/**
!backend/SmartRation.Api/**
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.js
!frontend/public/**
!frontend/src/**

# ...and never these, even inside allowed folders
**/__pycache__
**/*.pyc
**/.env
**/.env.*
backend/SmartRation.Api/bin
backend/SmartRation.Api/obj
backend/SmartRation.Api/**/*.db
backend/SmartRation.Api/**/*.db-*
backend/SmartRation.Api/appsettings.Development.json
