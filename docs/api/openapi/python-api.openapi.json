    "/api/auth/register": {
      "post": {
        "operationId": "register_api_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Self-registration always creates a Rural User account.",
                "properties": {
                  "email": {
                    "maxLength": 200,
                    "title": "Email",
                    "type": "string"
                  },
                  "fullName": {
                    "maxLength": 150,
                    "minLength": 2,
                    "title": "Fullname",
                    "type": "string"
                  },
                  "mobileNumber": {
                    "maxLength": 20,
                    "title": "Mobilenumber",
                    "type": "string"
                  },
                  "password": {
                    "maxLength": 100,
                    "minLength": 8,
                    "title": "Password",
                    "type": "string"
                  }
                },
                "required": [
                  "fullName",
                  "email",
                  "mobileNumber",
                  "password"
                ],
                "title": "RegisterRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Validation failed: `errors` lists \"Field: message\" items"
          },
          "409": {
            "description": "Email or mobile number already registered"
          },
          "429": {
            "description": "Too many attempts from this address (10/min)"
          }
        },
        "summary": "Register a Rural User account",
        "tags": [
          "auth"
        ]
      }
    },
