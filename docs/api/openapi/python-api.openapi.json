{
  "components": {
    "schemas": {
      "AuthData": {
        "properties": {
          "accessToken": {
            "description": "JWT (HS256), valid 15 minutes",
            "title": "Accesstoken",
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "description": "UTC, e.g. 2026-09-24T04:43:04.4875895Z",
            "title": "Accesstokenexpiresat",
            "type": "string"
          },
          "refreshToken": {
            "description": "Opaque; single use (rotated on refresh), valid 7 days",
            "title": "Refreshtoken",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "accessTokenExpiresAt",
          "user"
        ],
        "title": "AuthData",
        "type": "object"
      },
      "AuthEnvelope": {
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuthData"
              },
              {
                "type": "null"
              }
            ]
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message",
          "data",
          "errors"
        ],
        "title": "AuthEnvelope",
        "type": "object"
      },
      "ChatRequest": {
        "properties": {
          "articleId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Open a specific article (e.g. from 'related')",
            "title": "Articleid"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "en",
            "description": "en | hi | mr — the interface language; Devanagari messages are detected",
            "title": "Language"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The question, up to 500 characters.",
            "title": "Message"
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A quick-button category id instead of a message (e.g. 'documents')",
            "title": "Topic"
          }
        },
        "title": "ChatRequest",
        "type": "object"
      },
      "DatabaseHealthResponse": {
        "properties": {
          "latencyMs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "round trip of a trivial query; null when unreachable",
            "title": "Latencyms"
          },
          "migrations": {
            "description": "ok | behind | unknown — schema at the Alembic head this code expects",
            "title": "Migrations",
            "type": "string"
          },
          "status": {
            "description": "healthy | unhealthy",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "latencyMs",
          "migrations"
        ],
        "title": "DatabaseHealthResponse",
        "type": "object"
      },
      "EmptyEnvelope": {
        "properties": {
          "data": {
            "title": "Data",
            "type": "null"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message"
        ],
        "title": "EmptyEnvelope",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "aiService": {
            "description": "healthy | unhealthy | disabled — the Python AI/analytics service",
            "title": "Aiservice",
            "type": "string"
          },
          "chatbot": {
            "description": "healthy | unhealthy — knowledge base loaded and provider available",
            "title": "Chatbot",
            "type": "string"
          },
          "dataMode": {
            "description": "synthetic | real",
            "title": "Datamode",
            "type": "string"
          },
          "database": {
            "description": "healthy | unhealthy",
            "title": "Database",
            "type": "string"
          },
          "legacyApi": {
            "description": "healthy | unhealthy | disabled — the C# API behind the fallback proxy",
            "title": "Legacyapi",
            "type": "string"
          },
          "status": {
            "description": "healthy | degraded | unhealthy",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "legacyApi",
          "aiService",
          "chatbot",
          "dataMode"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "database, migrations, legacyApi: ok | failing | disabled (+ detail)",
            "title": "Checks",
            "type": "object"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "ready",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "UserSummary": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "fullName": {
            "title": "Fullname",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "mobileNumber": {
            "title": "Mobilenumber",
            "type": "string"
          },
          "rationShopId": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rationshopid"
          },
          "role": {
            "description": "RuralUser | ShopOwner | GovernmentOfficial | Admin",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "fullName",
          "email",
          "mobileNumber",
          "role",
          "rationShopId"
        ],
        "title": "UserSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nPython backend for Smart Ration HSD2C (side-by-side migration from the C#/.NET API).\n\n* Versioned: every route below answers under `/api/v1/...` as well as `/api/...` (same behaviour).\n* Every response uses the envelope `{success, message, data, errors}`; failures add `errorCode`.\n* `/api/*` routes that are not yet migrated are transparently served by the C# API\n  (fallback proxy); those do not appear in this document yet.\n",
    "title": "Smart Ration HSD2C API (Python)",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/audit/verification": {
      "get": {
        "operationId": "verification_audit_api_audit_verification_get",
        "parameters": [
          {
            "in": "query",
            "name": "shopId",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Shopid"
            }
          },
          {
            "in": "query",
            "name": "beneficiaryId",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Beneficiaryid"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "take",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Take",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verification audit trail (officials)",
        "tags": [
          "shop counter"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "email": {
                    "examples": [
                      "rural@example.com"
                    ],
                    "title": "Email",
                    "type": "string"
                  },
                  "password": {
                    "title": "Password",
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "title": "LoginRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Validation failed: `errors` lists \"Field: message\" items"
          },
          "401": {
            "description": "Invalid credentials / refresh token"
          },
          "429": {
            "description": "Too many attempts from this address (10/min)"
          }
        },
        "summary": "Log in with email and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
