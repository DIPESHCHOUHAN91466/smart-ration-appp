        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Validation failed: `errors` lists \"Field: message\" items"
          }
