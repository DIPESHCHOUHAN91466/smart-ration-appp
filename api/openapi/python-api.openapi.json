{
  "components": {
    "schemas": {
      "AuthData": {
        "properties": {
          "accessToken": {
            "description": "JWT (HS256), valid 15 minutes",
            "title": "Accesstoken",
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "description": "UTC, e.g. 2026-09-24T04:43:04.4875895Z",
            "title": "Accesstokenexpiresat",
            "type": "string"
          },
          "refreshToken": {
            "description": "Opaque; single use (rotated on refresh), valid 7 days",
            "title": "Refreshtoken",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "accessTokenExpiresAt",
          "user"
        ],
        "title": "AuthData",
        "type": "object"
      },
      "AuthEnvelope": {
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuthData"
              },
              {
                "type": "null"
              }
            ]
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message",
          "data",
          "errors"
        ],
        "title": "AuthEnvelope",
        "type": "object"
      },
      "ChatRequest": {
        "properties": {
          "articleId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Open a specific article (e.g. from 'related')",
            "title": "Articleid"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "en",
            "description": "en | hi | mr — the interface language; Devanagari messages are detected",
            "title": "Language"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The question, up to 500 characters.",
            "title": "Message"
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A quick-button category id instead of a message (e.g. 'documents')",
            "title": "Topic"
          }
        },
        "title": "ChatRequest",
        "type": "object"
      },
      "DatabaseHealthResponse": {
        "properties": {
          "latencyMs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "round trip of a trivial query; null when unreachable",
            "title": "Latencyms"
          },
          "migrations": {
            "description": "ok | behind | unknown — schema at the Alembic head this code expects",
            "title": "Migrations",
            "type": "string"
          },
          "status": {
            "description": "healthy | unhealthy",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "latencyMs",
          "migrations"
        ],
        "title": "DatabaseHealthResponse",
        "type": "object"
      },
      "EmptyEnvelope": {
        "properties": {
          "data": {
            "title": "Data",
            "type": "null"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message"
        ],
        "title": "EmptyEnvelope",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "aiService": {
            "description": "healthy | unhealthy | disabled — the Python AI/analytics service",
            "title": "Aiservice",
            "type": "string"
          },
          "chatbot": {
            "description": "healthy | unhealthy — knowledge base loaded and provider available",
            "title": "Chatbot",
            "type": "string"
          },
          "dataMode": {
            "description": "synthetic | real",
            "title": "Datamode",
            "type": "string"
          },
          "database": {
            "description": "healthy | unhealthy",
            "title": "Database",
            "type": "string"
          },
          "legacyApi": {
            "description": "healthy | unhealthy | disabled — the C# API behind the fallback proxy",
            "title": "Legacyapi",
            "type": "string"
          },
          "status": {
            "description": "healthy | degraded | unhealthy",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "legacyApi",
          "aiService",
          "chatbot",
          "dataMode"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "database, migrations, legacyApi: ok | failing | disabled (+ detail)",
            "title": "Checks",
            "type": "object"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "ready",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "UserSummary": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "fullName": {
            "title": "Fullname",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "mobileNumber": {
            "title": "Mobilenumber",
            "type": "string"
          },
          "rationShopId": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rationshopid"
          },
          "role": {
            "description": "RuralUser | ShopOwner | GovernmentOfficial | Admin",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "fullName",
          "email",
          "mobileNumber",
          "role",
          "rationShopId"
        ],
        "title": "UserSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nPython backend for Smart Ration HSD2C (side-by-side migration from the C#/.NET API).\n\n* Every response uses the envelope `{success, message, data, errors}`; failures add `errorCode`.\n* `/api/*` routes that are not yet migrated are transparently served by the C# API\n  (fallback proxy); those do not appear in this document yet.\n",
    "title": "Smart Ration HSD2C API (Python)",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "email": {
                    "examples": [
                      "rural@example.com"
                    ],
                    "title": "Email",
                    "type": "string"
                  },
                  "password": {
                    "title": "Password",
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "title": "LoginRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Validation failed: `errors` lists \"Field: message\" items"
          },
          "401": {
            "description": "Invalid credentials / refresh token"
          },
          "429": {
            "description": "Too many attempts from this address (10/min)"
          }
        },
        "summary": "Log in with email and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout_api_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "refreshToken": {
                    "title": "Refreshtoken",
                    "type": "string"
                  }
                },
                "required": [
                  "refreshToken"
                ],
                "title": "RefreshRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Validation failed: `errors` lists \"Field: message\" items"
          }
        },
        "summary": "Revoke a refresh token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "refresh_api_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "refreshToken": {
                    "title": "Refreshtoken",
                    "type": "string"
                  }
                },
                "required": [
                  "refreshToken"
                ],
                "title": "RefreshRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Validation failed: `errors` lists \"Field: message\" items"
          },
          "401": {
            "description": "Invalid credentials / refresh token"
          }
        },
        "summary": "Exchange a refresh token for new tokens (rotates it)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/register": {
      "post": {
        "operationId": "register_api_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Self-registration always creates a Rural User account.",
                "properties": {
                  "email": {
                    "maxLength": 200,
                    "title": "Email",
                    "type": "string"
                  },
                  "fullName": {
                    "maxLength": 150,
                    "minLength": 2,
                    "title": "Fullname",
                    "type": "string"
                  },
                  "mobileNumber": {
                    "maxLength": 20,
                    "title": "Mobilenumber",
                    "type": "string"
                  },
                  "password": {
                    "maxLength": 100,
                    "minLength": 8,
                    "title": "Password",
                    "type": "string"
                  }
                },
                "required": [
                  "fullName",
                  "email",
                  "mobileNumber",
                  "password"
                ],
                "title": "RegisterRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Validation failed: `errors` lists \"Field: message\" items"
          },
          "409": {
            "description": "Email or mobile number already registered"
          },
          "429": {
            "description": "Too many attempts from this address (10/min)"
          }
        },
        "summary": "Register a Rural User account",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/chatbot/message": {
      "post": {
        "operationId": "message_api_chatbot_message_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Empty or too-long message"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "summary": "Ask the Public Help assistant",
        "tags": [
          "public help"
        ]
      }
    },
    "/api/chatbot/welcome": {
      "get": {
        "operationId": "welcome_api_chatbot_welcome_get",
        "parameters": [
          {
            "description": "en | hi | mr (anything else falls back to en)",
            "in": "query",
            "name": "language",
            "required": false,
            "schema": {
              "default": "en",
              "description": "en | hi | mr (anything else falls back to en)",
              "maxLength": 5,
              "title": "Language",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Assistant greeting and quick buttons",
        "tags": [
          "public help"
        ]
      }
    },
    "/api/public-help/articles/{article_id}": {
      "get": {
        "operationId": "article_api_public_help_articles__article_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "article_id",
            "required": true,
            "schema": {
              "title": "Article Id",
              "type": "string"
            }
          },
          {
            "description": "en | hi | mr (anything else falls back to en)",
            "in": "query",
            "name": "language",
            "required": false,
            "schema": {
              "default": "en",
              "description": "en | hi | mr (anything else falls back to en)",
              "maxLength": 5,
              "title": "Language",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "One Public Help article",
        "tags": [
          "public help"
        ]
      }
    },
    "/api/public-help/categories": {
      "get": {
        "operationId": "categories_api_public_help_categories_get",
        "parameters": [
          {
            "description": "en | hi | mr (anything else falls back to en)",
            "in": "query",
            "name": "language",
            "required": false,
            "schema": {
              "default": "en",
              "description": "en | hi | mr (anything else falls back to en)",
              "maxLength": 5,
              "title": "Language",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Public Help sections and their articles",
        "tags": [
          "public help"
        ]
      }
    },
    "/api/public-help/search": {
      "get": {
        "operationId": "search_api_public_help_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "description": "en | hi | mr (anything else falls back to en)",
            "in": "query",
            "name": "language",
            "required": false,
            "schema": {
              "default": "en",
              "description": "en | hi | mr (anything else falls back to en)",
              "maxLength": 5,
              "title": "Language",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Public Help",
        "tags": [
          "public help"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Database unreachable"
          }
        },
        "summary": "Readiness: database and legacy API",
        "tags": [
          "health"
        ]
      }
    },
    "/health/db": {
      "get": {
        "operationId": "database_health_health_db_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseHealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseHealthResponse"
                }
              }
            },
            "description": "Database unreachable"
          }
        },
        "summary": "Database health (no connection details are returned)",
        "tags": [
          "health"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Not ready"
          }
        },
        "summary": "Readiness probe (database, migration version, legacy API)",
        "tags": [
          "health"
        ]
      }
    }
  }
}
