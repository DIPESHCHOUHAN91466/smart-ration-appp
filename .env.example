# Smart Ration HSD2C — every configuration value in one place (documentation).
# NOTHING here is a real value. Each component reads its own git-ignored file:
#   backend/SmartRation.Python/.env   backend/SmartRation.AI/.env   frontend/.env
#   C# API: dotnet user-secrets        docker-compose: .env at the repo root (deployment/docker/compose.env.example)
# This root .env is read only by the root MySQL tests (tests/mysql).

# ---------------------------------------------------------------- environment / data
APP_ENVIRONMENT=Development            # Python: ENVIRONMENT=development|production ; C#: ASPNETCORE_ENVIRONMENT
DATA_MODE=synthetic                    # synthetic (demo data) | real  → real is BLOCKED until real integrations exist

# ---------------------------------------------------------------- root MySQL tests (tests/mysql)
# Optional, legacy: tests/mysql now uses TEST_DATABASE_URL or the Python API's DATABASE_URL (pointed at
# smartration_test). Only set these if you need to override that.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartration_test               # must end in _test
DB_USER=smartration_app
DB_PASSWORD=

# ---------------------------------------------------------------- Python API (backend/SmartRation.Python/.env)
DATABASE_URL=mysql+pymysql://smartration_app:<password>@localhost:3306/smartration?charset=utf8mb4
JWT_SECRET_KEY=                        # = C# user-secret Jwt:Key
LEGACY_API_URL=http://localhost:5188   # the C# business API
AI_SERVICE_URL=http://127.0.0.1:8001   # only for /health; empty disables the check
CORS_ORIGINS=http://localhost:5173
CHATBOT_PROVIDER=knowledge             # knowledge (default) — an LLM provider is not implemented
CHATBOT_API_KEY=                       # reserved for a future LLM provider
CHATBOT_KNOWLEDGE_DIR=                 # default: <repo>/ai/chatbot/knowledge
SYNTHETIC_DATA_DIR=                    # default: <repo>/data/synthetic/reference
SEED=2026                              # scripts/generate_test_data.py default seed (same seed = same data)
SYNTHETIC_USER_PASSWORD=               # optional: lets generated test citizens log in (never commit a value)

# ---------------------------------------------------------------- AI service (backend/SmartRation.AI/.env)
SMARTRATION_AI_DB_URL=mysql+pymysql://smartration_ai:<password>@localhost:3306/smartration   # read-only account
SMARTRATION_AI_API_KEY=                # = C# user-secret AiService:ApiKey

# ---------------------------------------------------------------- frontend (frontend/.env)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1   # 127.0.0.1, not localhost (IPv6 clash). Unset: local API in dev, same-origin /api/v1 in production builds (a bare /api gets /v1 added)
VITE_DEMO_MODE=true                    # shows the demo-account buttons on the login page
VITE_SHOW_STATUS=false                 # /status page in production builds

# ---------------------------------------------------------------- C# API (dotnet user-secrets, never a file)
# Database:Provider=MySql
# ConnectionStrings:MySql=Server=localhost;Port=3306;Database=smartration;User=smartration_app;Password=<password>
# Jwt:Key=<64+ random characters>
# Qr:Secret=<64+ random characters — keep the same value on an existing install>
# AiService:ApiKey=<random key>
