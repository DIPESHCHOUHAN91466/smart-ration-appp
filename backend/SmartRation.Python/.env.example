# Copy to .env (git-ignored) and fill in. Never commit real values.
ENVIRONMENT=development

# The SAME MySQL database the C# API uses (application account, not root):
#   mysql+pymysql://smartration_app:<password>@localhost:3306/smartration?charset=utf8mb4
DATABASE_URL=

# Side-by-side migration: routes not yet migrated are proxied to the C# API.
# Leave empty to disable the fallback proxy.
LEGACY_API_URL=http://localhost:5188
LEGACY_API_TIMEOUT_SECONDS=30

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

MAX_REQUEST_BYTES=6291456
LOG_LEVEL=INFO

# Added in later migration steps (auth, QR). They MUST equal the C# API's
# user-secrets Jwt:Key / Qr:Secret so tokens and issued QR codes stay valid:
# JWT_SECRET_KEY=
# QR_SECRET=
