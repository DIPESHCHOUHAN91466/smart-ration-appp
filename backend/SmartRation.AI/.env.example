# Copy to .env (git-ignored) and fill in. Never commit real values.

# Read-only database account. MySQL:
#   mysql+pymysql://smartration_ai:<password>@localhost:3306/smartration?charset=utf8mb4
# SQLite (development, opened read-only):
#   sqlite:///file:C:/path/to/backend/SmartRation.Api/smartration.db?mode=ro&uri=true
SMARTRATION_AI_DB_URL=

# Shared secret; must equal AiService:ApiKey in the .NET API (user-secrets).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SMARTRATION_AI_API_KEY=

# Write-capable account, used ONLY by scripts/generate_history.py (dev/demo data):
#   mysql+pymysql://smartration_app:<password>@localhost:3306/smartration?charset=utf8mb4
SMARTRATION_WRITE_DB_URL=

# Optional OCR (needs Tesseract installed + pip install pytesseract Pillow)
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# OCR_LANGS=eng+hin+mar

# Optional tuning (defaults shown)
SHOP_UTC_OFFSET_MINUTES=330
FORECAST_DAYS=7
FORECAST_MIN_HISTORY_DAYS=14
LOW_STOCK_DAYS=7
CRITICAL_STOCK_DAYS=3
DEFAULT_SERVICE_MINUTES=4
MIN_SERVICE_SAMPLES=5
ANALYSIS_WINDOW_DAYS=30
LOG_LEVEL=INFO
