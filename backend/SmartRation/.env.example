# Copy to .env (git-ignored) and fill in. Never commit real values.
# development | staging | production (anything else is refused at start-up). staging and production
# share the production rules: no demo OTP, no mock SMS without opt-in, no API explorer, HSTS in production.
ENVIRONMENT=development

# The SAME MySQL database the C# API uses (application account, not root):
#   mysql+pymysql://smartration_app:<password>@localhost:3306/smartration?charset=utf8mb4
DATABASE_URL=

# Retired C# API fallback proxy. Leave empty (the default): every route is served by this Python API.
LEGACY_API_URL=
LEGACY_API_TIMEOUT_SECONDS=30
# Optional: connections to the C# API as N small pools used in turn (see docs/testing/LOAD_TESTING.md)
# LEGACY_API_POOLS=8
# LEGACY_API_CONNECTIONS_PER_POOL=8

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

MAX_REQUEST_BYTES=6291456
LOG_LEVEL=INFO

# Swagger UI /docs, /redoc and /openapi.json. Unset: on in development, off in staging/production.
# API_DOCS_ENABLED=false

# ---- Authentication (Step 2) ----
# MUST equal the C# API's user-secret Jwt:Key, so tokens work on both backends.
# The app refuses to start without it.
JWT_SECRET_KEY=
# Defaults match the C# API; change only together with it.
# JWT_ISSUER=SmartRationHSD2C
# JWT_AUDIENCE=SmartRationHSD2C.Clients
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# Upgrade BCrypt password hashes to Argon2id after a successful login.
# PASSWORD_UPGRADE_TO_ARGON2=true
# AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- Public Help chatbot ----
# CHATBOT_PROVIDER=knowledge            # retrieval over app/ai/chatbot/knowledge (default; no API key needed)
# CHATBOT_API_KEY=                      # reserved for a future generative provider
# CHATBOT_RATE_LIMIT_PER_MINUTE=30
# PUBLIC_HELP_RATE_LIMIT_PER_MINUTE=120

# ---- QR codes (REQUIRED: the API refuses to start without it) ----
# HMAC-SHA256 key that signs every booking QR. Generate ONCE and keep it stable: changing it invalidates
# every QR already issued. Never commit the real value; in production use the platform's secret store.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# An installation migrated from the old C# API must reuse its user-secret Qr:Secret value.
QR_SECRET=replace_with_a_secure_random_secret

# ---- Optional settings (defaults shown; uncomment only to change) ----
# synthetic | real (real refuses to start until real providers exist)
# DATA_MODE=synthetic
# path to frontend/dist to serve the website from this API (Docker sets it)
# FRONTEND_DIST_DIR=
# QR scan / complaint limits per client IP per minute
# SCAN_RATE_LIMIT_PER_MINUTE=120
# GRIEVANCE_RATE_LIMIT_PER_MINUTE=5
# OTP fallback. The demo OTP is DEVELOPMENT ONLY: the app refuses to start with it in production.
# DEMO_OTP_ENABLED=true
# DEMO_OTP_VALUE=
# OTP_EXPIRY_MINUTES=5
# OTP_MAX_ATTEMPTS=3
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_RATE_LIMIT_PER_MINUTE=6
# SMS: "mock" sends nothing (development); "http" posts to a DLT-registered gateway
# SMS_PROVIDER=mock
# SMS_BASE_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=SMRTRN
# synthetic public demo only; never with real data
# SMS_ALLOW_MOCK_OUTSIDE_DEVELOPMENT=false
# AI analytics service (forecasts, alerts, OCR); empty URL disables it
# AI_SERVICE_URL=http://127.0.0.1:8001
# = SMARTRATION_AI_API_KEY of the AI service
# AI_SERVICE_API_KEY=
# AI_SERVICE_TIMEOUT_SECONDS=8
# Days of booking slots kept open ahead of today (synthetic mode)
# UPCOMING_SLOT_DAYS=7
