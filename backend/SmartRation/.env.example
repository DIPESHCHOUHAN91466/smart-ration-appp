# Copy to .env (git-ignored) and fill in. Never commit real values.
ENVIRONMENT=development

# The SAME MySQL database the C# API uses (application account, not root):
#   mysql+pymysql://smartration_app:<password>@localhost:3306/smartration?charset=utf8mb4
DATABASE_URL=

# Side-by-side migration: routes not yet migrated are proxied to the C# API.
# Leave empty to disable the fallback proxy.
LEGACY_API_URL=http://localhost:5188
LEGACY_API_TIMEOUT_SECONDS=30
# Optional: connections to the C# API as N small pools used in turn (see docs/testing/LOAD_TESTING.md)
# LEGACY_API_POOLS=8
# LEGACY_API_CONNECTIONS_PER_POOL=8

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

MAX_REQUEST_BYTES=6291456
LOG_LEVEL=INFO

# ---- Authentication (Step 2) ----
# MUST equal the C# API's user-secret Jwt:Key, so tokens work on both backends.
# The app refuses to start without it.
JWT_SECRET_KEY=
# Defaults match the C# API; change only together with it.
# JWT_ISSUER=SmartRationHSD2C
# JWT_AUDIENCE=SmartRationHSD2C.Clients
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# Upgrade BCrypt password hashes to Argon2id after a successful login.
# PASSWORD_UPGRADE_TO_ARGON2=true
# AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- Public Help chatbot ----
# CHATBOT_PROVIDER=knowledge            # retrieval over app/ai/chatbot/knowledge (default; no API key needed)
# CHATBOT_API_KEY=                      # reserved for a future generative provider
# CHATBOT_RATE_LIMIT_PER_MINUTE=30
# PUBLIC_HELP_RATE_LIMIT_PER_MINUTE=120

# ---- QR codes (REQUIRED: the API refuses to start without it) ----
# HMAC-SHA256 key that signs every booking QR. Generate ONCE and keep it stable: changing it invalidates
# every QR already issued. Never commit the real value; in production use the platform's secret store.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# An installation migrated from the old C# API must reuse its user-secret Qr:Secret value.
QR_SECRET=replace_with_a_secure_random_secret
